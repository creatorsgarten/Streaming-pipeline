# Copy to .env (scripts/setup.sh does it and fills the secrets for you).
HUB_SECRET=change-me-at-least-32-characters-long-random
ADMIN_PASSWORD=change-me
INTERNAL_TOKEN=change-me-16-plus-chars
# plain http on localhost: cookies without the Secure flag
SECURE_COOKIES=0
# optional: Bearer token for /metrics (otherwise it needs a signed-in session)
# METRICS_TOKEN=
