# HTTPS in front of the dashboard (used with COMPOSE_PROFILES=https). Caddy gets the certificate itself.
{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	# compress pages and API answers, but never the live update stream (text/event-stream):
	# a compressor buffers it and the dashboard would sit still
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type text/plain*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy hub:8080 {
		# server-sent events: pass every chunk straight through
		flush_interval -1
	}
}
